{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "src/app/api/auto-collect/route.ts": { "maxDuration": 180 },
    "src/app/api/collection/route.ts": { "maxDuration": 180 },
    "src/app/api/**/*.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
