DATABASE_URL="file:./dev.db"

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=

# Google Identity Services (for client-side Google Sign-In)
# Get this from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# This is PUBLIC information - safe to expose in browser (starts with numbers like 123456789-...)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Google OAuth (for server-side OAuth flow - optional, for GitHub-style OAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (for social login)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Reddit OAuth (for social media collection)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_REDIRECT_URI=http://localhost:3000/auth/callback

# LinkedIn OAuth (optional - for LinkedIn social collection)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Twitter/X OAuth (optional - for Twitter social collection)
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# Email Service Configuration (for digest delivery)
# Option 1: Resend (recommended)
RESEND_API_KEY=your_resend_api_key

# Option 2: Custom SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

FROM_EMAIL=noreply@insightflow.ai

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default User (for single-user mode)
DEFAULT_USER_ID=default-user

# Security Configuration

# Rate Limiting (using Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Environment
NODE_ENV=development
# NODE_ENV=production  # Use this in production for secure cookies


# Security Configuration (DISABLED by default for development)
# Set to 'true' to enable these features in production
RATE_LIMIT_ENABLED=false
CSRF_ENABLED=false
AUTH_ENABLED=false

# =============================================================================
# LLM Rate Limiting Configuration
# =============================================================================
# Custom rate limits per model (overrides defaults)
# Format: RATE_LIMIT_{PROVIDER}_{MODEL}_TPM={tokens_per_minute}
# Examples:
# RATE_LIMIT_GROQ_MOONSHOTAI_KIMI_K2_INSTRUCT_TPM=10000
# RATE_LIMIT_GROQ_LLAMA_3_3_70B_VERSATILE_TPM=12000
# RATE_LIMIT_GROQ_META_LLAMA_LLAMA_4_SCOUT_TPM=30000
# RATE_LIMIT_GROQ_COMPOUND_TPM=70000

# Fallback provider configuration (triggered when primary hits rate limits)
FALLBACK_PROVIDER=zhipuai
FALLBACK_MODEL=glm-4.5

# Content Assessment Batch Configuration
ASSESSMENT_BATCH_SIZE=3
ASSESSMENT_INTER_BATCH_DELAY=2000
ASSESSMENT_INTRA_BATCH_DELAY=800
ASSESSMENT_MAX_CONCURRENT=3

# Tag Generation Batch Configuration
TAGS_BATCH_SIZE=5
TAGS_INTER_BATCH_DELAY=1000
TAGS_INTRA_BATCH_DELAY=200
TAGS_MAX_CONCURRENT=5

# Summary Generation Batch Configuration
SUMMARY_BATCH_SIZE=2
SUMMARY_INTER_BATCH_DELAY=3000
SUMMARY_INTRA_BATCH_DELAY=1000
SUMMARY_MAX_CONCURRENT=2

# Query Optimization Batch Configuration
QUERY_BATCH_SIZE=10
QUERY_INTER_BATCH_DELAY=500
QUERY_INTRA_BATCH_DELAY=100
QUERY_MAX_CONCURRENT=10

# Retry Configuration (exponential backoff)
RETRY_MAX_RETRIES=3
RETRY_BASE_DELAY=1000
RETRY_MAX_DELAY=10000
