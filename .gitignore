backup_*.json
*.backup
*.bak
*.backup.*

# Jest configuration (when not running tests)
jest.config.js
jest.setup.js

# Test reports and outputs
*_test_report.md
test-report*.md

# One-off test/verification scripts at root level
/test-*.ts
/verification_*.ts
/debug_*.ts

# Log files
*.log
logs/*.log

# Dry-run test scripts
scripts/dry-run-*.js

# Marketing/sales materials
InsightFlow_*

# Refactor/design reports (internal use)
refactor/
